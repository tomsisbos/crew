#!/usr/bin/env bash
#
# crew-bridge — surface herdr agent-state transitions.
#
# Agent state (done / idle / working) is PULL-ONLY: read it on demand with
# `crew status`, the herdr sidebar, or `herdr pane list`. The bridge no longer
# pushes state into the agmsg message stream. Doing so was expensive and noisy:
# crew agents run in agmsg *monitor* mode, where every delivered row wakes the
# recipient and costs it a full turn — so a single "X is done" fan-out spent
# (team-1) turns on telemetry nobody acted on, and the wakeups it caused flipped
# recipients working->done, which got re-announced, waking everyone again in an
# endless broadcast->wake->rebroadcast loop.
#
# Directed agent<->agent messages still flow through agmsg untouched — those are
# real notifications and worth a wakeup. State is not.
#
# The one state with proactive value is `blocked` ("needs input") — but the
# audience is the human, not the peer agents. On a transition into a notify
# state (default: blocked) the bridge raises a herdr desktop notification, which
# costs zero agent tokens. Everything else is left for `crew status` to pull.
#
# Intentionally a poll loop (pure bash + jq) over `herdr pane list`: herdr 0.7's
# pane.agent_status_changed subscription needs a pane_id per pane, so a poll is
# the simpler, more robust v1. See README "Roadmap" for the event-driven upgrade.
#
# Run via `crew bridge`; `crew new` / `crew watch` also start one in the
# background (pidfile under the state dir keeps it a singleton).

set -euo pipefail

CREW_CONF="${CREW_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/crew/crew.conf}"
TEAM="crew"
AGMSG_CMD="agmsg"
# States that raise a (human-facing) herdr notification on entry. Space-separated
# subset of: blocked done idle working. Default: blocked only — the sole state a
# person needs to act on. State is otherwise pull-only (see `crew status`).
BRIDGE_NOTIFY="blocked"
BRIDGE_INTERVAL="3"
# shellcheck source=/dev/null
[ -f "$CREW_CONF" ] && . "$CREW_CONF"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/crew"

# Human-readable hint per state.
hint() {
  case "$1" in
    blocked) echo "needs input";;
    done)    echo "finished / awaiting next";;
    idle)    echo "idle / free";;
    working) echo "working";;
    *)       echo "$1";;
  esac
}

# Is <status> one of the configured states we raise a human notification for?
notifies() {
  local s="$1" t
  for t in $BRIDGE_NOTIFY; do [ "$s" = "$t" ] && return 0; done
  return 1
}

log() { printf '%s crew-bridge: %s\n' "$(date '+%H:%M:%S')" "$*"; }

log "watching (notify human on: '$BRIDGE_NOTIFY'; other state is pull-only via 'crew status'; interval ${BRIDGE_INTERVAL}s)"

while :; do
  snapshot="$(herdr pane list 2>/dev/null || true)"
  if [ -n "$snapshot" ]; then
    # iterate every registered crew agent
    for desc in "$STATE_DIR"/agents/*/*.json; do
      [ -f "$desc" ] || continue
      name="$(jq -r '.name' "$desc")"
      team="$(jq -r '.team' "$desc")"
      pane="$(jq -r '.pane_id' "$desc")"
      laststatus_file="${desc%.json}.laststatus"

      status="$(printf '%s' "$snapshot" \
        | jq -r --arg p "$pane" '.result.panes[]? | select(.pane_id==$p) | .agent_status')"
      # pane gone (worktree retired) — leave the registry alone, just skip.
      [ -n "$status" ] || continue

      last="unknown"; [ -f "$laststatus_file" ] && last="$(cat "$laststatus_file")"
      [ "$status" = "$last" ] && continue

      # Record the transition so `crew status` and the log stay current. This is
      # the only side effect for done/idle/working — they are pull-only now.
      printf '%s' "$status" >"$laststatus_file"
      log "$team/$name: $last -> $status"

      # The only proactive push left is a desktop notification to the human, for
      # the configured notify states (default: blocked = needs input). No agmsg
      # fan-out to peers — that woke the whole team for telemetry and looped.
      # laststatus above already gates this to real transitions *into* the state,
      # so a steady blocked agent is toasted once, not every poll.
      notifies "$status" || continue
      herdr notification show "crew: $name — $(hint "$status")" \
        --body "$name → $status ($(hint "$status")). Open it in herdr to respond." \
        --sound request >/dev/null 2>&1 \
        || log "$team/$name: herdr notification failed (is the herdr server up?)"
    done
  fi
  sleep "$BRIDGE_INTERVAL"
done
