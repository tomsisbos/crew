# crew configuration — copy to ~/.config/crew/crew.conf and edit.
# Every value below is also the built-in default, so an empty config is fine.

# Name of the agmsg team all crew agents join.
TEAM="crew"

# Installed agmsg command name (the --cmd you passed to agmsg's install.sh).
# Determines the script path ~/.agents/skills/<AGMSG_CMD>/scripts.
AGMSG_CMD="agmsg"

# Command launched in each worktree pane. Override per-run with CREW_AGENT_CMD,
# e.g. to pass flags: CREW_AGENT_CMD="claude --model opus" crew new ...
AGENT_CMD="claude"

# Which herdr agent_status transitions raise a *desktop notification to you*.
# Space-separated subset of: blocked done idle working
#   blocked = agent is waiting for input  (the one state a human should act on)
#   done    = agent finished its turn      (usually just noise for a person)
#   idle    = finished AND already viewed
#   working = agent started working
# Default is blocked only. Agent state is otherwise PULL-ONLY: the bridge no
# longer pushes it into teammates' agmsg inboxes (that woke every agent and cost
# a turn each in monitor mode). Read state on demand with `crew status`, the
# herdr sidebar, or `herdr pane list`. Directed agent<->agent agmsg messages are
# unaffected — those are real notifications and still delivered.
BRIDGE_NOTIFY="blocked"

# How often (seconds) the bridge polls herdr for state changes.
BRIDGE_INTERVAL="3"

# How often (seconds) `crew watch` polls herdr for new worktrees to adopt.
WATCH_INTERVAL="3"

# Whether `crew watch` shows a herdr toast when you create a plain (non-worktree)
# workspace on the main checkout — a reminder that only worktrees become crew agents.
# Set to "0" to silence it.
WATCH_NUDGE="1"
